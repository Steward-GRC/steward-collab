# Local development settings. Copy to .env (git-ignored) and load it in the
# run target, for example with `dotenv: ['.env']` in the Taskfile.
#
# Local dev logs everything in human-readable form. Cluster environments set
# their own level and always log JSON: dev cluster debug, qa/staging info,
# production error.
LOG_LEVEL=trace
LOG_FORMAT=console

# Required. The token secret signs the co-editing tokens: at least 32 bytes,
# shared with nothing else.
DATABASE_DSN=postgres://collab:collab@localhost:5432/collab?sslmode=disable
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
COLLAB_TOKEN_SECRET=change-me-to-32-or-more-random-bytes

# The services collab calls.
CORE_GRPC_ADDR=localhost:9090
IDENTITY_GRPC_ADDR=localhost:9091

# Ports: gRPC, and HTTP for the websocket upgrades, /livez and /readyz.
GRPC_PORT=9093
HTTP_PORT=8081

# Token lifetime, an origin for the issued websocket path (empty is
# same-origin), and browser origins allowed to upgrade directly (empty: only
# through the gateway's proxy).
COLLAB_TOKEN_TTL_SECONDS=300
COLLAB_WS_BASE=
COLLAB_ALLOWED_ORIGINS=

# Service-to-service authentication. Callers (the gateway) send a projected
# service-account token with audience steward; collab verifies it against the
# cluster's JWKS and its per-method allow-list. Collab sends its own token to
# core and identity. Local runs without a cluster switch it off; never in a
# cluster.
WORKLOAD_AUTH=disabled
# WORKLOAD_OIDC_ISSUER=https://kubernetes.default.svc
# WORKLOAD_OIDC_JWKS_URL=
# WORKLOAD_OIDC_CA_FILE=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt
# WORKLOAD_OIDC_BEARER_FILE=/var/run/secrets/kubernetes.io/serviceaccount/token
# WORKLOAD_AUDIENCE=steward
# WORKLOAD_ALLOWED_SERVICEACCOUNTS=steward/steward-gateway
# WORKLOAD_TOKEN_FILE=/var/run/secrets/steward/token
